{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "matchpal",
  "version": "0.1.0",
  "identifier": "com.aurobreeze.matchpal",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "matchpal",
        "width": 1000,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560
      },
      {
        "label": "floating",
        "url": "floating.html",
        "title": "matchpal 悬浮窗",
        "width": 272,
        "height": 74,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"]
  }
}
